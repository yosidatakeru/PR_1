Shader "Custom/LiquidMetal"
{
    Properties
    {
        // =====================================================
        // 液体金属の基本色
        // =====================================================
        _MetalColor
        (
            "Metal Color",
            Color
        ) = (0.65, 0.7, 0.75, 1)


        // =====================================================
        // 金属の反射の強さ
        // =====================================================
        _Metallic
        (
            "Metallic",
            Range(0, 1)
        ) = 1.0


        // =====================================================
        // 表面の滑らかさ
        //
        // 1 = ツルツル
        // 0 = ザラザラ
        // =====================================================
        _Smoothness
        (
            "Smoothness",
            Range(0, 1)
        ) = 0.9


        // =====================================================
        // 液体量
        //
        // 0 = 空
        // 1 = 満タン
        // =====================================================
        _LiquidAmount
        (
            "Liquid Amount",
            Range(0, 1)
        ) = 0.7


        // =====================================================
        // 表面の歪み
        // =====================================================
        _Distortion
        (
            "Distortion",
            Range(0, 0.2)
        ) = 0.05


        // =====================================================
        // 歪みの細かさ
        // =====================================================
        _DistortionScale
        (
            "Distortion Scale",
            Range(1, 20)
        ) = 5


        // =====================================================
        // 歪みの速度
        // =====================================================
        _DistortionSpeed
        (
            "Distortion Speed",
            Range(0, 5)
        ) = 1


        // =====================================================
        // Fresnel
        // =====================================================
        _FresnelPower
        (
            "Fresnel Power",
            Range(0.1, 10)
        ) = 3


        _FresnelStrength
        (
            "Fresnel Strength",
            Range(0, 5)
        ) = 2
    }


    SubShader
    {
        Tags
        {
            "Queue" = "Transparent"
            "RenderType" = "Transparent"
        }

        Blend SrcAlpha OneMinusSrcAlpha

        ZWrite On


        Pass
        {
            CGPROGRAM

            #pragma vertex vert
            #pragma fragment frag

            #include "UnityCG.cginc"


            // =================================================
            // 頂点データ
            // =================================================

            struct appdata
            {
                float4 vertex : POSITION;

                float3 normal : NORMAL;
            };


            // =================================================
            // 頂点 → フラグメント
            // =================================================

            struct v2f
            {
                float4 vertex : SV_POSITION;

                float3 worldPos : TEXCOORD0;

                float3 worldNormal : TEXCOORD1;
            };


            // =================================================
            // Shader変数
            // =================================================

            float4 _MetalColor;

            float _Metallic;

            float _Smoothness;

            float _LiquidAmount;

            float _Distortion;

            float _DistortionScale;

            float _DistortionSpeed;

            float _FresnelPower;

            float _FresnelStrength;


            // =================================================
            // Vertex Shader
            // =================================================

            v2f vert(appdata v)
            {
                v2f o;


                // オブジェクト座標
                // ↓
                // 画面座標
                o.vertex =
                    UnityObjectToClipPos(v.vertex);


                // ワールド座標を取得
                o.worldPos =
                    mul(
                        unity_ObjectToWorld,
                        v.vertex
                    ).xyz;


                // 法線をワールド空間へ変換
                o.worldNormal =
                    UnityObjectToWorldNormal(
                        v.normal
                    );


                return o;
            }


            // =================================================
            // Fragment Shader
            // =================================================

            fixed4 frag(v2f i) : SV_Target
            {
                // =================================================
                // 液面の高さ
                // =================================================

                float liquidHeight =
                    lerp(
                        -0.5,
                        0.5,
                        _LiquidAmount
                    );


                // =================================================
                // 液面より上を消す
                // =================================================

                if (i.worldPos.y > liquidHeight)
                {
                    discard;
                }


                // =================================================
                // カメラ方向
                // =================================================

                float3 viewDir =
                    normalize(
                        _WorldSpaceCameraPos
                        -
                        i.worldPos
                    );


                // =================================================
                // 法線
                // =================================================

                float3 normal =
                    normalize(
                        i.worldNormal
                    );


                // =================================================
                // Fresnel
                //
                // 視線が浅くなるほど強く光らせる。
                // 液体金属の「縁のギラッとした反射」
                // を作る。
                // =================================================

                float fresnel =
                    pow(
                        1.0 -
                        saturate(
                            dot(
                                normal,
                                viewDir
                            )
                        ),
                        _FresnelPower
                    );


                // =================================================
                // 液体金属の基本色
                // =================================================

                float3 color =
                    _MetalColor.rgb;


                // =================================================
                // Fresnelを追加
                // =================================================

                color +=
                    fresnel
                    *
                    _FresnelStrength;


                // =================================================
                // 金属っぽく暗くする
                // =================================================

                color *=
                    lerp(
                        0.5,
                        1.0,
                        _Metallic
                    );


                // =================================================
                // 最終結果
                // =================================================

                return float4(
                    color,
                    1.0
                );
            }

            ENDCG
        }
    }
}